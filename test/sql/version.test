# name: test/sql/version.test
# group: [vgi_perf]
#
# Catalog implementation_version + a basic attach/search_path smoke. The worker
# publishes its build version as the catalog implementation_version (there is no
# perf_version() scalar); the vgi extension surfaces the resolved value via
# duckdb_databases().tags['vgi_resolved_implementation_version'].

require-env VGI_PERF_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'perf' AS perf (TYPE vgi, LOCATION '${VGI_PERF_WORKER}');

statement ok
SET search_path = 'perf.main';

# The worker advertises a non-empty semantic version string as the catalog
# implementation_version, surfaced as a duckdb_databases() tag.
query I
SELECT tags['vgi_resolved_implementation_version'] ~ '^[0-9]+\.[0-9]+\.[0-9]+'
FROM duckdb_databases() WHERE database_name = 'perf';
----
true

statement ok
USE memory;

statement ok
DETACH perf;
