      "comms",
      null,
      "table",
      "Decode perf.data process/thread name (COMM) records into rows",
      null,
      {
        "vgi.category": "Capture Context",
        "vgi.doc_llm": "Decode the command/thread-name records (PERF_RECORD_COMM) of a Linux perf.data capture into rows \u2014 what each pid/tid is called (e.g. 'chrome', 'postgres'). `src` is a `VARCHAR` path or a `BLOB` of perf.data bytes. Columns: `pid`, `tid`, `comm` (the name), and `time` (the record timestamp, or NULL if the capture records no sample-id times). Join `pid` to `samples.pid` to turn a numeric pid into a human-readable process name when reporting hotspots.",
        "vgi.doc_md": "Decode perf.data COMM records into rows: `pid`, `tid`, `comm` (name), `time`. Join `pid` to `samples.pid` to label samples with a process name. `src` is a path or `BLOB`.",
        "vgi.example_queries": "[{\"description\":\"The distinct process/thread names in a capture, one row per pid \u2014 the lookup that turns a numeric pid from `samples` into a human-readable command.\",\"sql\":\"SELECT DISTINCT pid, comm FROM perf.main.comms(from_hex('')) ORDER BY pid\"}]",
        "vgi.executable_examples": "[{\"description\":\"The distinct process/thread names in a capture, one row per pid \u2014 the lookup that turns a numeric pid from `samples` into a human-readable command.\",\"sql\":\"SELECT DISTINCT pid, comm FROM perf.main.comms(from_hex('')) ORDER BY pid\"}]",
        "vgi.keywords": "[\"perf\",\"perf.data\",\"comm\",\"process name\",\"thread name\",\"command\",\"pid\",\"tid\",\"exec\",\"process resolution\"]",
        "vgi.result_columns_schema": "[{\"name\":\"pid\",\"type\":\"INTEGER\",\"description\":\"Process id this name applies to.\"},{\"name\":\"tid\",\"type\":\"INTEGER\",\"description\":\"Thread id this name applies to.\"},{\"name\":\"comm\",\"type\":\"VARCHAR\",\"description\":\"The command / thread name.\"},{\"name\":\"time\",\"type\":\"UBIGINT\",\"description\":\"Record timestamp; NULL if not recorded.\"}]",
        "vgi.title": "perf.data Comm Records"
