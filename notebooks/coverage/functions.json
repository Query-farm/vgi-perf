      "perf",
      "22592",
      "main",
      "samples",
      null,
      "table",
      "Decode perf.data profiling samples (with raw call chains) into rows",
      null,
      {
        "vgi.category": "Profile Samples",
        "vgi.doc_llm": "Decode the profiling samples (PERF_RECORD_SAMPLE) of a Linux perf.data capture into rows \u2014 one per sampled event (e.g. a CPU `cycles` overflow). `src` is a `VARCHAR` path to a perf.data file or a `BLOB` of perf.data bytes. Columns: `time` (perf-clock nanoseconds), `pid`, `tid`, `cpu`, `ip` (the raw, unsymbolicated instruction pointer as `UBIGINT`), `period`, `event` (the event name, e.g. 'cycles'), and `callchain` (a `LIST(UBIGINT)` of raw instruction pointers from innermost to outermost frame, in capture order). Symbolication is NOT done here \u2014 join `ip` (and each callchain frame) to `mmaps` to find the backing DSO, then to vgi-symbols via the build-id. Any column the capture omits (no PERF_SAMPLE_CPU, no call chains, \u2026) is NULL. Use it to find hot instruction pointers, build flame data, or diff captures for CI performance-regression gates.",
        "vgi.doc_md": "Decode perf.data profiling samples into rows: `time`, `pid`, `tid`, `cpu`, `ip` (raw `UBIGINT`), `period`, `event`, and `callchain` (`LIST(UBIGINT)` of raw IPs). `src` is a path or a `BLOB`. IPs are unsymbolicated \u2014 join to `mmaps` + vgi-symbols to resolve. Rank raw IPs by frequency to find the hottest addresses in a capture.",
        "vgi.example_queries": "[{\"description\":\"The ten most frequent raw instruction pointers in a capture \u2014 the hottest addresses, pre-symbolication.\",\"sql\":\"SELECT ip, count(*) AS hits FROM perf.main.samples(from_hex('')) GROUP BY ip ORDER BY hits DESC LIMIT 10\"},{\"description\":\"The deepest call chains: each sample's leaf ip and how many frames its stack carries.\",\"sql\":\"SELECT ip, length(callchain) AS depth FROM perf.main.samples(from_hex('')) WHERE callchain IS NOT NULL ORDER BY depth DESC, ip LIMIT 10\"}]",
        "vgi.executable_examples": "[{\"description\":\"The ten most frequent raw instruction pointers in a capture \u2014 the hottest addresses, pre-symbolication.\",\"sql\":\"SELECT ip, count(*) AS hits FROM perf.main.samples(from_hex('')) GROUP BY ip ORDER BY hits DESC LIMIT 10\"},{\"description\":\"The deepest call chains: each sample's leaf ip and how many frames its stack carries.\",\"sql\":\"SELECT ip, length(callchain) AS depth FROM perf.main.samples(from_hex('')) WHERE callchain IS NOT NULL ORDER BY depth DESC, ip LIMIT 10\"}]",
        "vgi.keywords": "[\"perf\",\"perf.data\",\"perf record\",\"samples\",\"profiling\",\"profiler\",\"instruction pointer\",\"ip\",\"callchain\",\"call stack\",\"stack\",\"cycles\",\"hotspot\",\"flamegraph\",\"CPU profile\",\"performance\",\"linux perf\"]",
        "vgi.result_columns_schema": "[{\"name\":\"time\",\"type\":\"UBIGINT\",\"description\":\"Capture timestamp (perf clock, nanoseconds); NULL if not recorded.\"},{\"name\":\"pid\",\"type\":\"INTEGER\",\"description\":\"Process id the sample was taken in.\"},{\"name\":\"tid\",\"type\":\"INTEGER\",\"description\":\"Thread id the sample was taken in.\"},{\"name\":\"cpu\",\"type\":\"UINTEGER\",\"description\":\"CPU the sample was taken on; NULL if not recorded.\"},{\"name\":\"ip\",\"type\":\"UBIGINT\",\"description\":\"Raw (unsymbolicated) instruction pointer.\"},{\"name\":\"period\",\"type\":\"UBIGINT\",\"description\":\"Sample period at the time of the sample.\"},{\"name\":\"event\",\"type\":\"VARCHAR\",\"description\":\"Event name, e.g. 'cycles'.\"},{\"name\":\"callchain\",\"type\":\"UBIGINT[]\",\"description\":\"Raw IP frames, innermost to outermost; NULL if no call chains.\"}]",
        "vgi.title": "perf.data Samples"
      },
