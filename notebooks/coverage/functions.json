      "perf",
      "22592",
      "main",
      "events",
      null,
      "table",
      "Decode perf.data event attributes (name, type, sampling policy) into rows",
      null,
      {
        "vgi.category": "Capture Context",
        "vgi.doc_llm": "Decode the recorded event attributes of a Linux perf.data capture into rows \u2014 which perf events were sampled, and with what sampling policy. `src` is a `VARCHAR` path or a `BLOB` of perf.data bytes. Columns: `event_id` (the primary event id, or the attribute index when no ids are recorded), `name` (e.g. 'cycles', 'instructions'), `type` (the event kind: 'hardware', 'software', 'tracepoint', 'hw_cache', 'breakpoint', or 'dynamic_pmu'), `config` (the integer config, surfaced only for tracepoint / dynamic-PMU events; NULL for hardware/software/hw_cache/breakpoint, whose `name`/`type` already identify them), `sample_period` (fixed period, if period-sampled), and `sample_freq` (target samples/sec, if frequency-sampled). Use it to see what a capture measured and to label samples by event.",
        "vgi.doc_md": "Decode perf.data event attributes into rows: `event_id`, `name`, `type` (hardware/software/\u2026), `config`, `sample_period`, `sample_freq`. `src` is a path or `BLOB`. Use it to see which events a capture measured and how they were sampled.",
        "vgi.example_queries": "[{\"description\":\"The events a capture sampled, with each event's kind and its fixed sampling period (or target frequency).\",\"sql\":\"SELECT name, type, sample_period, sample_freq FROM perf.main.events(from_hex('')) ORDER BY name\"}]",
        "vgi.executable_examples": "[{\"description\":\"The events a capture sampled, with each event's kind and its fixed sampling period (or target frequency).\",\"sql\":\"SELECT name, type, sample_period, sample_freq FROM perf.main.events(from_hex('')) ORDER BY name\"}]",
        "vgi.keywords": "[\"perf\",\"perf.data\",\"event\",\"perf_event_attr\",\"attributes\",\"cycles\",\"instructions\",\"hardware event\",\"software event\",\"tracepoint\",\"sample period\",\"sample frequency\",\"pmu\"]",
        "vgi.result_columns_schema": "[{\"name\":\"event_id\",\"type\":\"UBIGINT\",\"description\":\"Primary event id, or the attribute index.\"},{\"name\":\"name\",\"type\":\"VARCHAR\",\"description\":\"Event name, e.g. 'cycles'.\"},{\"name\":\"type\",\"type\":\"VARCHAR\",\"description\":\"Event kind: 'hardware', 'software', 'tracepoint', 'hw_cache', 'breakpoint', or 'dynamic_pmu'.\"},{\"name\":\"config\",\"type\":\"UBIGINT\",\"description\":\"Tracepoint/dynamic-PMU integer config; NULL for hardware/software/hw_cache/breakpoint.\"},{\"name\":\"sample_period\",\"type\":\"UBIGINT\",\"description\":\"Fixed sampling period; NULL if frequency-sampled.\"},{\"name\":\"sample_freq\",\"type\":\"UBIGINT\",\"description\":\"Target samples/sec; NULL if period-sampled.\"}]",
        "vgi.title": "perf.data Event Attributes"
      },
