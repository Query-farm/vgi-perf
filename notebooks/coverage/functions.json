      "perf",
      "22592",
      "main",
      "mmaps",
      null,
      "table",
      "Decode perf.data memory mappings (with build-ids) into rows",
      null,
      {
        "vgi.category": "Address Space",
        "vgi.doc_llm": "Decode the memory-mapping records (PERF_RECORD_MMAP / MMAP2) of a Linux perf.data capture into rows \u2014 which shared object / DSO backs each range of a process's address space. `src` is a `VARCHAR` path or a `BLOB` of perf.data bytes. Columns: `pid`, `tid`, `addr` (start address), `len` (length in bytes \u2014 the mapping covers [addr, addr+len)), `pgoff` (offset into the file), `filename` (e.g. '/usr/lib/libc.so.6', '[vdso]'), and `build_id` (the DSO build-id as lowercase hex, from an inline MMAP2 build-id record or the HEADER_BUILD_ID feature section; NULL when unknown). These are what make a sample `ip` interpretable: join `samples.ip BETWEEN m.addr AND m.addr + m.len` to find which DSO an IP fell in, and feed `build_id` + the IP to vgi-symbols for native symbolication. Collapsed-stack text files throw this information away; the binary perf.data keeps it.",
        "vgi.doc_md": "Decode perf.data memory mappings into rows: `pid`, `tid`, `addr`, `len`, `pgoff`, `filename`, `build_id` (lowercase hex, or NULL). Range-join `samples.ip BETWEEN addr AND addr+len` to attribute an IP to a DSO; `build_id` feeds vgi-symbols. `src` is a path or `BLOB`.",
        "vgi.example_queries": "[{\"description\":\"Mapped DSOs with a known build-id (for vgi-symbols).\",\"sql\":\"SELECT filename, build_id FROM perf.main.mmaps(from_hex('')) WHERE build_id IS NOT NULL ORDER BY filename\"},{\"description\":\"Hottest mapped files: join sample ips to DSOs by address range, rank by hits.\",\"sql\":\"SELECT m.filename, count(*) AS hits FROM perf.main.samples(from_hex('')) s JOIN perf.main.mmaps(from_hex('')) m ON s.pid = m.pid AND s.ip BETWEEN m.addr AND m.addr + m.len GROUP BY 1 ORDER BY 2 DESC\"}]",
        "vgi.executable_examples": "[{\"description\":\"Mapped DSOs with a known build-id (for vgi-symbols).\",\"sql\":\"SELECT filename, build_id FROM perf.main.mmaps(from_hex('')) WHERE build_id IS NOT NULL ORDER BY filename\"},{\"description\":\"Hottest mapped files: join sample ips to DSOs by address range, rank by hits.\",\"sql\":\"SELECT m.filename, count(*) AS hits FROM perf.main.samples(from_hex('')) s JOIN perf.main.mmaps(from_hex('')) m ON s.pid = m.pid AND s.ip BETWEEN m.addr AND m.addr + m.len GROUP BY 1 ORDER BY 2 DESC\"}]",
        "vgi.keywords": "[\"perf\",\"perf.data\",\"mmap\",\"mmap2\",\"memory mapping\",\"dso\",\"shared object\",\"build id\",\"build_id\",\"symbolication\",\"symbols\",\"address range\",\"module\",\"library\",\"vdso\"]",
        "vgi.result_columns_schema": "[{\"name\":\"pid\",\"type\":\"INTEGER\",\"description\":\"Process id the mapping belongs to.\"},{\"name\":\"tid\",\"type\":\"INTEGER\",\"description\":\"Thread id the mapping belongs to.\"},{\"name\":\"addr\",\"type\":\"UBIGINT\",\"description\":\"Start address of the mapping.\"},{\"name\":\"len\",\"type\":\"UBIGINT\",\"description\":\"Length in bytes; the mapping covers [addr, addr+len).\"},{\"name\":\"pgoff\",\"type\":\"UBIGINT\",\"description\":\"Offset into the mapped file.\"},{\"name\":\"filename\",\"type\":\"VARCHAR\",\"description\":\"Mapped file path, e.g. '/usr/lib/libc.so.6'.\"},{\"name\":\"build_id\",\"type\":\"VARCHAR\",\"description\":\"DSO build-id (lowercase hex); NULL if unknown.\"}]",
        "vgi.title": "perf.data Memory Mappings"
      },
