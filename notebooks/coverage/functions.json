      "perf",
      "22592",
      "main",
      "meta",
      null,
      "table",
      "Decode perf.data capture-wide metadata (host, arch, cmdline, \u2026) into one row",
      null,
      {
        "vgi.category": "Capture Context",
        "vgi.doc_llm": "Decode the capture-wide metadata of a Linux perf.data file into a single row, read from its HEADER_* feature sections. `src` is a `VARCHAR` path or a `BLOB` of perf.data bytes. Columns: `hostname`, `arch` (e.g. 'x86_64'), `nrcpus` (CPUs available on the capture host), `perf_version` (the perf tool version), `cmdline` (the `perf record` command line as a `LIST(VARCHAR)`), and `total_events` (the count of event records in the data section). perf.data varies by kernel and perf build \u2014 any feature section a given capture omits comes back NULL (graceful degradation). Use it to label a fleet of captures by host / arch / tool version and to sanity-check event counts.",
        "vgi.doc_md": "Decode perf.data capture metadata into one row: `hostname`, `arch`, `nrcpus`, `perf_version`, `cmdline` (`LIST(VARCHAR)`), `total_events`. Omitted HEADER_* sections are NULL. `src` is a path or `BLOB`.",
        "vgi.example_queries": "[{\"description\":\"Read the capture-wide metadata of a perf.data file (exactly one row): host, arch, tool version, and the total event-record count.\",\"sql\":\"SELECT hostname, arch, nrcpus, perf_version, cmdline, total_events FROM perf.main.meta(from_hex(''))\"}]",
        "vgi.executable_examples": "[{\"description\":\"Read the capture-wide metadata of a perf.data file (exactly one row): host, arch, tool version, and the total event-record count.\",\"sql\":\"SELECT hostname, arch, nrcpus, perf_version, cmdline, total_events FROM perf.main.meta(from_hex(''))\"}]",
        "vgi.keywords": "[\"perf\",\"perf.data\",\"metadata\",\"header\",\"hostname\",\"arch\",\"architecture\",\"nrcpus\",\"perf version\",\"cmdline\",\"command line\",\"total events\",\"capture info\"]",
        "vgi.result_columns_schema": "[{\"name\":\"hostname\",\"type\":\"VARCHAR\",\"description\":\"Capture host name; NULL if absent.\"},{\"name\":\"arch\",\"type\":\"VARCHAR\",\"description\":\"Machine architecture, e.g. 'x86_64'; NULL if absent.\"},{\"name\":\"nrcpus\",\"type\":\"UINTEGER\",\"description\":\"CPUs available on the capture host; NULL if absent.\"},{\"name\":\"perf_version\",\"type\":\"VARCHAR\",\"description\":\"perf tool version; NULL if absent.\"},{\"name\":\"cmdline\",\"type\":\"VARCHAR[]\",\"description\":\"The 'perf record' command line, split into arguments; NULL if absent.\"},{\"name\":\"total_events\",\"type\":\"UBIGINT\",\"description\":\"Count of event records in the data section.\"}]",
        "vgi.title": "perf.data Capture Metadata"
      },
